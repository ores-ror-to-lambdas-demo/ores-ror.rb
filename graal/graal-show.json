{
  "profile": "gs-ruby-lambda-v1",
  "app_root": "..",
  "bootstrap": "graal/bootstrap.rb",
  "build_target_env": "ORES_BUILD_TARGET=lambda",
  "generated_manifest": "generated/lambda/manifest.json",
  "generated_entrypoint": "generated/lambda/entrypoint.rb",
  "rails_boot": false,
  "max_concurrency_per_isolate": 5,
  "max_isolate_age_seconds": 1800,
  "idle_retire_seconds": 300,
  "guest_created_threads": false,
  "child_processes": false,
  "native_ffi": false,
  "raw_sockets": false,
  "database_transport": "host-http",
  "request_identity": "x-request-id"
}
