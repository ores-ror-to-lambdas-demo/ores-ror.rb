{
  "profile": "gs-ruby-lambda-v2",
  "app_root": "..",
  "bootstrap": "graal/bootstrap.rb",
  "server": "graal/server.rb",
  "build_target_env": "ORES_BUILD_TARGET=lambda",
  "handler_granularity_env": "ORES_LAMBDA_HANDLER_GRANULARITY",
  "default_handler_granularity": "route",
  "generated_manifest": "generated/lambda/manifest.json",
  "generated_entrypoint": "generated/lambda/entrypoint.rb",
  "generated_route_handlers": "generated/lambda/routes/**/handler.rb",
  "generated_group_handlers": "generated/lambda/groups/*/handler.rb",
  "rails_boot": false,
  "worker_unit": "polyglot-inner-context",
  "worker_is_os_process": false,
  "host_processes": 1,
  "engine_scope": "host-process",
  "worker_pool_key": "handler-path",
  "cross_handler_context_reuse": false,
  "default_contexts_per_handler": 2,
  "max_concurrency_per_context": 1,
  "context_reuse": "same-handler-warm",
  "context_code_sharing": true,
  "host_thread_strategy": "one-host-thread-per-live-inner-context",
  "max_context_age_seconds": 1800,
  "idle_retire_seconds": 300,
  "guest_created_threads": false,
  "child_processes": false,
  "native_ffi": false,
  "raw_sockets_in_worker": false,
  "database_transport": "host-http",
  "request_identity": "x-request-id",
  "request_state": "explicit-envelope"
}
