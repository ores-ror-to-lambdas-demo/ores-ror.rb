#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "erb"
require "fileutils"
require "json"
require "pathname"
require_relative "../lib/ores_build/static_routes"

ROOT = File.realpath(File.expand_path("..", __dir__))
OUTPUT_ROOT = File.expand_path(ENV.fetch("ORES_BUILD_OUTPUT", "../generated"), __dir__)
LAMBDA_DIR = File.join(OUTPUT_ROOT, "lambda")
GRAAL_DIR = File.join(OUTPUT_ROOT, "graal")
INFRA_ROOT = File.expand_path(ENV.fetch("ORES_INFRA_ROOT", "../ores-ror.infra"), ROOT)
GRAAL_BOOTSTRAP = File.expand_path(
  ENV.fetch("ORES_GRAAL_BOOTSTRAP", File.join(INFRA_ROOT, "graal/bootstrap.rb")),
  ROOT
)
GRAAL_CONTEXT_THREAD_POOL_SIZE = 5

abort "Rails must not be loaded during Lambda/Graal generation" if defined?(Rails) && ENV.fetch("ORES_BUILD_TARGET", "rails") != "rails"


abort "ORES_BUILD_OUTPUT may not be the application root" if OUTPUT_ROOT == ROOT

def path_present?(path)
  File.exist?(path) || File.symlink?(path)
end

def reject_symlink_components!(path, label)
  Pathname(File.expand_path(path)).ascend.to_a.reverse_each do |component|
    next unless path_present?(component.to_s)
    stat = File.lstat(component.to_s)
    abort "#{label} contains a symlink component: #{component}" if stat.symlink?
  end
end

def confined_file!(root, path, label)
  root = File.expand_path(root)
  abort "#{label} root is a symlink: #{root}" if File.symlink?(root)
  root_real = File.realpath(root)
  candidate = File.expand_path(path)
  relative = Pathname(candidate).relative_path_from(Pathname(root))
  abort "#{label} escapes allowed root: #{candidate}" if relative.to_s == ".." || relative.to_s.start_with?("../")

  cursor = root
  relative.each_filename do |segment|
    cursor = File.join(cursor, segment)
    begin
      stat = File.lstat(cursor)
    rescue Errno::ENOENT
      abort "#{label} does not exist: #{relative}"
    end
    abort "#{label} contains a symlink: #{relative}" if stat.symlink?
  end

  resolved = File.realpath(candidate)
  root_prefix = root_real + File::SEPARATOR
  abort "#{label} escapes allowed root: #{relative}" unless resolved.start_with?(root_prefix)
  abort "#{label} is not a regular file: #{relative}" unless File.file?(resolved)
  resolved
rescue ArgumentError
  abort "#{label} escapes allowed root: #{path}"
end

def read_app_source(relative, label = "application source")
  File.read(confined_file!(ROOT, File.join(ROOT, relative), label))
end

def read_runtime_source(path, label = "runtime source")
  expanded = File.expand_path(path)
  infra_root = File.expand_path(INFRA_ROOT)
  if expanded.start_with?(ROOT + File::SEPARATOR)
    File.read(confined_file!(ROOT, expanded, label))
  elsif expanded.start_with?(infra_root + File::SEPARATOR)
    File.read(confined_file!(INFRA_ROOT, expanded, label))
  else
    abort "#{label} is outside application/infra roots: #{expanded}"
  end
end

def owned_generated_dir?(path, schemas)
  return false unless File.directory?(path)
  return false if File.symlink?(path)

  manifest_path = File.join(path, "manifest.json")
  return false unless File.file?(manifest_path) && !File.symlink?(manifest_path)

  manifest = JSON.parse(File.read(manifest_path))
  schemas.include?(manifest["schema"]) && manifest["application"] == "ores-ror.rb"
rescue JSON::ParserError, Errno::ENOENT
  false
end

def safe_remove_generated_dir!(path, schemas)
  return unless path_present?(path)
  abort "refusing to remove symlinked generated output #{path}" if File.symlink?(path)
  abort "refusing to remove non-directory generated output #{path}" unless File.directory?(path)
  return FileUtils.rm_rf(path) if Dir.empty?(path)

  abort "refusing to remove unowned generated output #{path}" unless owned_generated_dir?(path, schemas)
  FileUtils.rm_rf(path)
end

reject_symlink_components!(OUTPUT_ROOT, "ORES_BUILD_OUTPUT")

def ruby_const(value)
  value.to_s.split(/[^A-Za-z0-9]+/).reject(&:empty?).map { |part| part[0].to_s.upcase + part[1..].to_s }.join
end

def route_id(route)
  route[:route_id] ||= begin
    digest = Digest::SHA256.hexdigest("#{route.fetch(:verb)} #{route.fetch(:path)} #{route.fetch(:controller)}##{route.fetch(:action)}")[0, 12]
    "#{route.fetch(:name)}-#{digest}"
  end
end

def route_const(route)
  "R#{Digest::SHA256.hexdigest(route_id(route))[0, 16]}"
end

def fs_segment(segment)
  return "_root" if segment.empty?
  return "[#{segment.delete_prefix(":")}]" if segment.start_with?(":")

  segment.gsub(/[^A-Za-z0-9._-]+/, "-")
end

def route_unit_relative(route, prefix: "routes")
  segments = route.fetch(:path).split("/").reject(&:empty?).map { |segment| fs_segment(segment) }
  segments = ["_root"] if segments.empty?
  File.join(prefix, *segments, "_#{route.fetch(:verb).downcase}", "handler.rb")
end

def group_unit_relative(group, prefix: "groups")
  safe = group.to_s.gsub(/[^A-Za-z0-9._-]+/, "-")
  File.join(prefix, safe, "handler.rb")
end

GENERATED_HANDLER_MARKER = "GENERATED ORES RAILS-FREE HANDLER. DO NOT EDIT OR COMMIT."

def endpoint_handler_relative(route)
  controller_file = route.fetch(:controller_file)
  unless File.basename(controller_file) == "endpoint_controller.rb"
    abort "Lambda/Graal endpoint must use a dedicated endpoint_controller.rb directory: #{controller_file}"
  end
  File.join(File.dirname(controller_file), "handler.rb")
end

def endpoint_handler_const(route)
  relative_dir = Pathname(File.dirname(route.fetch(:controller_file))).relative_path_from(Pathname("app/controllers"))
  modules = relative_dir.each_filename.map { |part| ruby_const(part) }
  abort "endpoint controller must live under app/controllers/<endpoint>/" if modules.empty?
  (modules + ["Handler"]).join("::")
end

def clean_generated_endpoint_handlers!
  Dir.glob(File.join(ROOT, "app/controllers/**/handler.rb")).each do |path|
    stat = File.lstat(path)
    abort "refusing to follow symlinked generated handler sidecar: #{path}" if stat.symlink?
    abort "refusing to replace non-regular handler sidecar: #{path}" unless stat.file?

    source = File.read(path)
    abort "refusing to overwrite non-generated handler sidecar: #{path}" unless source.include?(GENERATED_HANDLER_MARKER)
    FileUtils.rm_f(path)
  end
end

def generated_handler_source(route)
  constant = endpoint_handler_const(route)
  modules = constant.split("::")
  body = <<~RUBY
    CONTROLLER_PATH = #{route.fetch(:controller).inspect}.freeze
    CONTROLLER_CLASS = #{route.fetch(:controller_class).inspect}.freeze
    ACTION = #{route.fetch(:action).inspect}.freeze
    VIEW_LOGICAL_PATH = #{route.fetch(:view_logical_path).inspect}.freeze
    VIEW_FILES = #{route.fetch(:view_files).inspect}.freeze

    module_function

    def call(request)
      ::#{route.fetch(:controller_class)}.call_ores_action(ACTION, request)
    end
  RUBY

  indent = +""
  nested = +""
  modules.each do |name|
    nested << "#{indent}module #{name}\n"
    indent << "  "
  end
  body.each_line { |line| nested << "#{indent}#{line}" }
  modules.reverse_each do
    indent = indent.delete_suffix("  ")
    nested << "#{indent}end\n"
  end

  <<~RUBY
    # frozen_string_literal: true
    # #{GENERATED_HANDLER_MARKER}
    # Rails endpoint: #{route.fetch(:controller)}##{route.fetch(:action)}
    # Rails source: #{route.fetch(:controller_file)}
    # Rails view lookup: #{route.fetch(:view_logical_path)}

    #{nested}
  RUBY
end

def prepare_endpoint_handlers!(routes)
  clean_generated_endpoint_handlers!

  routes.each do |route|
    route[:handler_path] = endpoint_handler_relative(route)
    route[:handler_constant] = endpoint_handler_const(route)
  end

  collisions = routes.group_by { |route| route.fetch(:handler_path) }.select do |_path, rows|
    rows.map { |route| [route.fetch(:controller), route.fetch(:action)] }.uniq.length > 1
  end
  unless collisions.empty?
    detail = collisions.map do |path, rows|
      "#{path}: #{rows.map { |route| "#{route[:controller]}##{route[:action]}" }.uniq.join(", ")}"
    end.join("; ")
    abort "multiple Rails endpoints collide on one generated handler.rb: #{detail}"
  end

  routes.group_by { |route| route.fetch(:handler_path) }.each_value do |rows|
    route = rows.first
    path = File.join(ROOT, route.fetch(:handler_path))
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, generated_handler_source(route))
  end
end

def endpoint_handler_source(route)
  read_runtime_source(File.join(ROOT, route.fetch(:handler_path)), "generated endpoint handler")
end

APPLICATION_MODEL_FILE = "app/models/application_model.rb"
APPLICATION_CONTROLLER_FILE = "app/controllers/application_controller.rb"
ORES_ENDPOINT_CONTROLLER_FILE = "app/controllers/ores_endpoint_controller.rb"
JSON_CODEC_FILE = "lib/ores_app/json_codec.rb"
URL_CODEC_FILE = "lib/ores_app/url_codec.rb"
CONTROLLER_RUNTIME_FILE = "lib/ores_app/controller_runtime.rb"
VIEW_RUNTIME_FILE = "lib/ores_app/view_runtime.rb"

FORBIDDEN_HANDLER_SOURCE = {
  /\brequire\s*(?:\(|["'])/ => "dynamic require",
  /\b(?:File|Dir|IO)\s*\./ => "filesystem API",
  /\b(?:Process\.|system\s*\(|exec\s*\(|spawn\s*\(|fork\b)/ => "process API",
  /\b(?:Socket|TCPSocket|UDPSocket|UNIXSocket)\b/ => "raw socket API",
  /\b(?:Fiddle|FFI)\b/ => "native FFI",
  /\bThread\s*\.\s*(?:new|start|fork)\b/ => "guest-created thread"
}.freeze

def view_file_for(route, format)
  route.fetch(:view_files).find { |file| file.end_with?(".#{format}.erb") } ||
    abort("route #{route.fetch(:name)} has no .#{format}.erb view")
end

def validate_app_dependencies!(routes)
  abort "missing #{APPLICATION_MODEL_FILE}" unless File.file?(File.join(ROOT, APPLICATION_MODEL_FILE))

  executable_sources = [APPLICATION_MODEL_FILE] +
    routes.map { |route| route.fetch(:model_file) } +
    routes.map { |route| route.fetch(:controller_file) } +
    routes.flat_map { |route| %w[json html].map { |format| view_file_for(route, format) } }
  executable_sources.uniq.each do |relative|
    source = read_app_source(relative, "MVC source")
    FORBIDDEN_HANDLER_SOURCE.each do |pattern, label|
      abort "MVC source #{relative} uses forbidden #{label}" if source.match?(pattern)
    end
  end
end

def route_model_sources(routes)
  routes.map { |route| route.fetch(:model_file) }.uniq.map do |relative|
    <<~RUBY
      # --- APP MODEL #{relative} (executed) ---
      #{flatten_ruby_source(File.join(ROOT, relative))}
    RUBY
  end.join("\n")
end

def route_controller_sources(routes)
  routes.map { |route| route.fetch(:controller_file) }.uniq.map do |relative|
    <<~RUBY
      # --- APP CONTROLLER #{relative} (executed) ---
      #{flatten_ruby_source(File.join(ROOT, relative))}
    RUBY
  end.join("\n")
end

def embedded_view_registration(routes)
  files = routes.flat_map { |route| route.fetch(:view_files) }.uniq
  entries = files.map do |relative|
    logical = relative.delete_prefix("app/views/")
    compiled = ERB.new(read_app_source(relative, "view source")).src
    compiled_body = compiled.lines.map { |line| "          #{line}" }.join

    <<~RUBY.rstrip
      #{logical.inspect} => lambda do |locals|
        scope = Object.new
        locals.each do |name, value|
          scope.define_singleton_method(name) { value }
        end
        scope.instance_exec do
#{compiled_body}
        end
      end
    RUBY
  end

  indented = entries.map { |entry| entry.lines.map { |line| "      #{line}" }.join.rstrip }.join(",\n")
  <<~RUBY
    # --- APP VIEWS (ERB compiled at build time; no guest ERB compiler) ---
    OresApp::ViewRuntime.add({
#{indented}
    })
  RUBY
end

def shared_runtime_source(mode)
  source = String.new(<<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    # Shared controller/model/runtime code for #{mode} execution.

    ORES_EXECUTION_MODE = #{mode.inspect} unless defined?(ORES_EXECUTION_MODE)
  RUBY
  source << "ORES_GRAAL_RUNTIME = true unless defined?(ORES_GRAAL_RUNTIME)\n" if mode == "graal"
  [
    JSON_CODEC_FILE,
    URL_CODEC_FILE,
    "lib/ores_app/routes.rb",
    "lib/ores_app/middleware.rb",
    "lib/ores_app/http_database.rb",
    "lib/ores_app/handlers.rb",
    "lib/ores_app/thread_state_boundary.rb",
    "lib/ores_app/dispatcher.rb",
    CONTROLLER_RUNTIME_FILE,
    VIEW_RUNTIME_FILE,
    APPLICATION_MODEL_FILE,
    ORES_ENDPOINT_CONTROLLER_FILE
  ].each do |relative|
    source << "\n# --- #{relative} ---\n"
    source << flatten_ruby_source(File.join(ROOT, relative))
    source << "\n"
  end
  source
end

def route_row(route)
  "OresApp::Routes::Route.new(" \
    "verb: #{route.fetch(:verb).inspect}, " \
    "path: #{route.fetch(:path).inspect}, " \
    "name: #{route.fetch(:name).inspect}, " \
    "controller: #{route.fetch(:controller).inspect}, " \
    "action: #{route.fetch(:action).inspect}, " \
    "middleware: #{route.fetch(:middleware).inspect}, " \
    "group: #{route.fetch(:group).inspect}, " \
    "pool: #{route.fetch(:pool).inspect}, " \
    "route_id: #{route_id(route).inspect})"
end

def route_manifest(route)
  route.merge(route_id: route_id(route)).reject { |key, _| key == :route_key }
end

def write_generated_routes(path, routes)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    module OresGenerated
      module Routes
        TABLE = [
          #{routes.map { |route| route_row(route) }.join(",\n          ")}
        ].freeze
      end
    end
  RUBY
end

def write_lambda_route_handler(path, route)
  FileUtils.mkdir_p(File.dirname(path))
  const = route_const(route)
  File.write(path, <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    # Generated endpoint sidecar: #{route.fetch(:handler_path)}

    #{route_model_sources([route])}
    #{embedded_view_registration([route])}
    #{route_controller_sources([route])}

    # --- GENERATED ENDPOINT SIDECAR #{route.fetch(:handler_path)} ---
    #{endpoint_handler_source(route)}

    module OresGenerated
      module RouteHandlers
        module #{const}
          module_function

          def call(request)
            ::#{route.fetch(:handler_constant)}.call(request)
          end
        end
      end
    end
  RUBY
end
def write_lambda_group_handler(path, group, routes)
  FileUtils.mkdir_p(File.dirname(path))
  route_requires = routes.map do |route|
    relative = route_unit_relative(route)
    %(require_relative "../../#{relative.delete_suffix(".rb")}")
  end.join("\n    ")
  cases = routes.map do |route|
    "when #{route_id(route).inspect} then OresGenerated::RouteHandlers::#{route_const(route)}.call(request)"
  end.join("\n            ")
  File.write(path, <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    #{route_requires}

    module OresGenerated
      module GroupHandlers
        module #{ruby_const(group)}
          module_function

          def call(route, request)
            case route.route_id
            #{cases}
            else
              raise ArgumentError, "route " + route.route_id.inspect + " does not belong to group #{group}"
            end
          end
        end
      end
    end
  RUBY
end

def write_lambda_entrypoint(routes, granularity)
  route_requires = routes.map do |route|
    relative = route_unit_relative(route)
    %(require_relative #{relative.delete_suffix(".rb").inspect})
  end
  grouped = routes.group_by { |route| route.fetch(:group) }
  group_requires = grouped.keys.sort.map do |group|
    relative = group_unit_relative(group)
    %(require_relative #{relative.delete_suffix(".rb").inspect})
  end

  resolver = if granularity == "route"
               cases = routes.map do |route|
                 "when #{route_id(route).inspect} then OresGenerated::RouteHandlers::#{route_const(route)}.call(request)"
               end.join("\n            ")
               <<~RUBY
                 def invoke(route, request)
                   case route.route_id
                   #{cases}
                   else
                     raise ArgumentError, "no generated route handler for " + route.route_id.inspect
                   end
                 end
               RUBY
             else
               cases = grouped.keys.sort.map do |group|
                 "when #{group.inspect} then OresGenerated::GroupHandlers::#{ruby_const(group)}.call(route, request)"
               end.join("\n            ")
               <<~RUBY
                 def invoke(route, request)
                   case route.group
                   #{cases}
                   else
                     raise ArgumentError, "no generated group handler for " + route.group.inspect
                   end
                 end
               RUBY
             end

  requires = granularity == "route" ? route_requires : group_requires
  File.write(File.join(LAMBDA_DIR, "entrypoint.rb"), <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    require_relative "common"
    require_relative "routes"
    #{requires.join("\n    ")}

    module OresGenerated
      module LambdaEntrypoint
        module_function

        #{resolver.lines.map { |line| "        #{line}" }.join}

        def call(request)
          OresApp::Dispatcher.call(request, routes: OresGenerated::Routes::TABLE, invoker: method(:invoke))
        end
      end
    end
  RUBY
end

def flatten_ruby_source(path)
  read_runtime_source(path).lines.reject { |line| line.match?(/^\s*require_relative\b/) }.join
end

def write_lambda_common
  FileUtils.mkdir_p(LAMBDA_DIR)
  path = File.join(LAMBDA_DIR, "common.rb")
  File.write(path, shared_runtime_source("lambda"))
  path
end

def write_graal_common
  FileUtils.mkdir_p(GRAAL_DIR)
  path = File.join(GRAAL_DIR, "common.rb")
  File.write(path, shared_runtime_source("graal"))
  path
end

def graal_unit_source(routes)
  cases = routes.map do |route|
    "when #{route_id(route).inspect} then ::#{route.fetch(:handler_constant)}.call(request)"
  end.join("\n          ")

  String.new(<<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    # Unit-specific source evaluated once after generated/graal/common.rb.

    module OresGenerated
      module Routes
        TABLE = [
          #{routes.map { |route| route_row(route) }.join(",\n          ")}
        ].freeze
      end

      module GraalEntrypoint
        module_function

        def invoke(route, request)
          case route.route_id
          #{cases}
          else
            raise ArgumentError, "route is not part of this isolate: " + route.route_id.inspect
          end
        end
      end
    end
  RUBY
end

def write_graal_unit(relative, routes)
  path = File.join(GRAAL_DIR, relative)
  FileUtils.mkdir_p(File.dirname(path))
  source = String.new("# frozen_string_literal: true\n# GENERATED FILE. DO NOT EDIT OR COMMIT.\n")
  source << "\n#{route_model_sources(routes)}\n"
  source << "\n#{embedded_view_registration(routes)}\n"
  source << "\n#{route_controller_sources(routes)}\n"
  routes.each do |route|
    source << "\n# --- GENERATED ENDPOINT SIDECAR #{route.fetch(:handler_path)} ---\n"
    source << endpoint_handler_source(route)
    source << "\n"
  end
  source << graal_unit_source(routes)
  source << "\n# --- infra graal/bootstrap.rb ---\n"
  source << flatten_ruby_source(GRAAL_BOOTSTRAP)
  source << "\n"
  File.write(path, source)
  path
end
def compile_routes
  OresBuild::StaticRoutes.new(ROOT).compile.each do |route|
    route[:route_id] = route_id(route)
  end
end

def clean_output
  safe_remove_generated_dir!(LAMBDA_DIR, ["ores-lambda-manifest/v6"])
  safe_remove_generated_dir!(GRAAL_DIR, ["ores-graal-ruby-manifest/v4"])
end

target = ENV.fetch("ORES_BUILD_TARGET", "rails").downcase

case target
when "rails"
  clean_output
  warn "build target=rails: no FaaS artifacts generated; boot the normal Rails application"
when "lambda"
  abort "Rails must not be loaded during Lambda generation" if defined?(Rails)
  granularity = ENV.fetch("ORES_LAMBDA_HANDLER_GRANULARITY", "route").downcase
  abort "ORES_LAMBDA_HANDLER_GRANULARITY must be route or group" unless %w[route group].include?(granularity)

  routes = compile_routes
  abort "no statically resolvable application routes found" if routes.empty?
  prepare_endpoint_handlers!(routes)
  validate_app_dependencies!(routes)
  safe_remove_generated_dir!(LAMBDA_DIR, ["ores-lambda-manifest/v6"])
  FileUtils.mkdir_p(LAMBDA_DIR)
  write_lambda_common
  write_generated_routes(File.join(LAMBDA_DIR, "routes.rb"), routes)
  routes.each do |route|
    write_lambda_route_handler(File.join(LAMBDA_DIR, route_unit_relative(route)), route)
  end
  routes.group_by { |route| route.fetch(:group) }.each do |group, grouped|
    write_lambda_group_handler(File.join(LAMBDA_DIR, group_unit_relative(group)), group, grouped)
  end
  write_lambda_entrypoint(routes, granularity)

  manifest = {
    "schema" => "ores-lambda-manifest/v6",
    "application" => "ores-ror.rb",
    "entrypoint" => "generated/lambda/entrypoint.rb",
    "shared_source" => "generated/lambda/common.rb",
    "runtime" => "ruby",
    "rails_boot" => false,
    "rails_application_initialized" => false,
    "route_source" => "config/routes.rb:ripper-static",
    "rails_route_authority" => "config/routes.rb",
    "route_handler_authority" => "generated app/controllers/**/handler.rb sidecars",
    "route_handler_mapping_mode" => "rails-convention-generated-sidecar",
    "mvc_source_root" => "app",
    "application_model" => APPLICATION_MODEL_FILE,
    "controller_packaging" => "direct-executable-source",
    "model_runtime" => "embedded-executable-source",
    "view_runtime" => "build-time-compiled-erb-renderers",
    "router_runtime" => "generated-rails-route-contract",
    "middleware_runtime" => "controller-lifecycle-shared-ruby",
    "controller_invocation" => "plain-ruby-controller-instance#action",
    "framework_components" => [],
    "handler_granularity" => granularity,
    "routes" => routes.map do |route|
      route_manifest(route).merge(
        route_handler_mapping: "generated-sidecar",
        source_handler: route.fetch(:handler_path),
        route_handler: "generated/lambda/#{route_unit_relative(route)}",
        group_handler: "generated/lambda/#{group_unit_relative(route.fetch(:group))}"
      )
    end
  }
  File.write(File.join(LAMBDA_DIR, "manifest.json"), JSON.pretty_generate(manifest) + "\n")
  warn "build target=lambda: compiled #{routes.length} Rails-authored routes without loading Rails; granularity=#{granularity}"
when "graal"
  abort "Rails must not be loaded during Graal generation" if defined?(Rails)
  abort "missing infra-owned Graal bootstrap: #{GRAAL_BOOTSTRAP}" unless File.file?(GRAAL_BOOTSTRAP)
  confined_file!(INFRA_ROOT, GRAAL_BOOTSTRAP, "Graal bootstrap")
  routes = compile_routes
  abort "no statically resolvable application routes found" if routes.empty?
  prepare_endpoint_handlers!(routes)
  validate_app_dependencies!(routes)
  safe_remove_generated_dir!(GRAAL_DIR, ["ores-graal-ruby-manifest/v4"])
  write_graal_common

  units = []
  routes.each do |route|
    relative = route_unit_relative(route)
    write_graal_unit(relative, [route])
    units << {
      "kind" => "route",
      "key" => "route:#{route_id(route)}",
      "route_ids" => [route_id(route)],
      "group" => route.fetch(:group),
      "source_handler" => route.fetch(:handler_path),
      "route_handler_mapping" => "generated-sidecar",
      "app_sources" => [route.fetch(:controller_file), route.fetch(:model_file), *route.fetch(:view_files)],
      "sources" => ["generated/graal/common.rb", "generated/graal/#{relative}"],
      "language_context" => "ruby",
      "context_count" => 1,
      "host_thread_pool_size" => GRAAL_CONTEXT_THREAD_POOL_SIZE,
      "guest_owner_threads" => GRAAL_CONTEXT_THREAD_POOL_SIZE,
      "execution_concurrency" => GRAAL_CONTEXT_THREAD_POOL_SIZE,
      "request_multiplexing" => true,
      "admission_limit" => GRAAL_CONTEXT_THREAD_POOL_SIZE
    }
  end
  routes.group_by { |route| route.fetch(:group) }.each do |group, grouped|
    relative = group_unit_relative(group)
    write_graal_unit(relative, grouped)
    units << {
      "kind" => "group",
      "key" => "group:#{group}",
      "route_ids" => grouped.map { |route| route_id(route) },
      "group" => group,
      "source_handlers" => grouped.map { |route| route.fetch(:handler_path) },
      "route_handler_mappings" => grouped.to_h { |route| [route_id(route), "generated-sidecar"] },
      "app_sources" => grouped.flat_map { |route| [route.fetch(:controller_file), route.fetch(:model_file), *route.fetch(:view_files)] }.uniq,
      "sources" => ["generated/graal/common.rb", "generated/graal/#{relative}"],
      "language_context" => "ruby",
      "context_count" => 1,
      "host_thread_pool_size" => GRAAL_CONTEXT_THREAD_POOL_SIZE,
      "guest_owner_threads" => GRAAL_CONTEXT_THREAD_POOL_SIZE,
      "execution_concurrency" => GRAAL_CONTEXT_THREAD_POOL_SIZE,
      "request_multiplexing" => true,
      "admission_limit" => GRAAL_CONTEXT_THREAD_POOL_SIZE
    }
  end

  manifest = {
    "schema" => "ores-graal-ruby-manifest/v4",
    "application" => "ores-ror.rb",
    "runtime" => "truffleruby",
    "rails_boot" => false,
    "rails_application_initialized" => false,
    "route_source" => "config/routes.rb:ripper-static",
    "rails_route_authority" => "config/routes.rb",
    "route_handler_authority" => "generated app/controllers/**/handler.rb sidecars",
    "route_handler_mapping_mode" => "rails-convention-generated-sidecar",
    "mvc_source_root" => "app",
    "application_model" => APPLICATION_MODEL_FILE,
    "controller_packaging" => "direct-executable-source",
    "model_runtime" => "embedded-executable-source",
    "view_runtime" => "build-time-compiled-erb-renderers",
    "router_runtime" => "generated-rails-route-contract",
    "middleware_runtime" => "controller-lifecycle-shared-ruby",
    "runtime_adapter_repository" => "ores-ror-to-lambdas-demo/ores-ror.infra",
    "runtime_adapter_source" => "graal/bootstrap.rb",
    "controller_invocation" => "plain-ruby-controller-instance#action",
    "framework_components" => [],
    "engine_scope" => "process-shared",
    "language_context" => "ruby",
    "contexts_per_isolate" => 1,
    "host_thread_pool_size_per_context" => GRAAL_CONTEXT_THREAD_POOL_SIZE,
    "guest_owner_threads_per_context" => GRAAL_CONTEXT_THREAD_POOL_SIZE,
    "execution_concurrency_per_context" => GRAAL_CONTEXT_THREAD_POOL_SIZE,
    "request_multiplexing" => true,
    "shared_source" => "generated/graal/common.rb",
    "source_memory" => "host-read-only-shareable",
    "context_lifetime" => "isolate",
    "context_model" => "one-long-lived-context-per-route-or-group-isolate",
    "supported_isolation_granularities" => %w[route group],
    "request_state" => "explicit-per-invocation",
    "thread_identity_is_request_identity" => false,
    "max_admitted_in_flight_per_isolate" => GRAAL_CONTEXT_THREAD_POOL_SIZE,
    "max_isolate_age_seconds" => 1800,
    "idle_retire_seconds" => 300,
    "hard_cancel_scope" => "isolate",
    "replacement_before_drain" => true,
    "host_http_binding" => "ores_gs_http",
    "guest_filesystem" => false,
    "guest_created_threads" => false,
    "child_processes" => false,
    "native_ffi" => false,
    "raw_sockets" => false,
    "database_transport" => "host-http",
    "routes" => routes.map { |route| route_manifest(route) },
    "isolate_units" => units
  }
  File.write(File.join(GRAAL_DIR, "manifest.json"), JSON.pretty_generate(manifest) + "\n")
  warn "build target=graal: generated #{routes.length} route isolates + #{routes.map { |route| route[:group] }.uniq.length} group isolates; Rails not loaded"
else
  abort "unsupported ORES_BUILD_TARGET=#{target.inspect}; expected rails, lambda, or graal"
end
