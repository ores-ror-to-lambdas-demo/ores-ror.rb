#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "pathname"
require_relative "../lib/ores_build/static_routes"

ROOT = File.expand_path("..", __dir__)
OUTPUT_ROOT = File.expand_path(ENV.fetch("ORES_BUILD_OUTPUT", "../generated"), __dir__)
LAMBDA_DIR = File.join(OUTPUT_ROOT, "lambda")
GRAAL_DIR = File.join(OUTPUT_ROOT, "graal")
MAX_GRAAL_THREADS = 5

abort "Rails must not be loaded during Lambda/Graal generation" if defined?(Rails) && ENV.fetch("ORES_BUILD_TARGET", "rails") != "rails"

def ruby_const(value)
  value.to_s.split(/[^A-Za-z0-9]+/).reject(&:empty?).map { |part| part[0].to_s.upcase + part[1..].to_s }.join
end

def route_id(route)
  route[:route_id] ||= begin
    digest = Digest::SHA256.hexdigest("#{route.fetch(:verb)} #{route.fetch(:path)} #{route.fetch(:controller)}##{route.fetch(:action)}")[0, 12]
    "#{route.fetch(:name)}-#{digest}"
  end
end

def route_const(route)
  "R#{Digest::SHA256.hexdigest(route_id(route))[0, 16]}"
end

def fs_segment(segment)
  return "_root" if segment.empty?
  return "[#{segment.delete_prefix(":")}]" if segment.start_with?(":")

  segment.gsub(/[^A-Za-z0-9._-]+/, "-")
end

def route_unit_relative(route, prefix: "routes")
  segments = route.fetch(:path).split("/").reject(&:empty?).map { |segment| fs_segment(segment) }
  segments = ["_root"] if segments.empty?
  File.join(prefix, *segments, "_#{route.fetch(:verb).downcase}", "handler.rb")
end

def group_unit_relative(group, prefix: "groups")
  safe = group.to_s.gsub(/[^A-Za-z0-9._-]+/, "-")
  File.join(prefix, safe, "handler.rb")
end

GENERATED_HANDLER_MARKER = "GENERATED ORES RAILS-FREE HANDLER. DO NOT EDIT OR COMMIT."

def endpoint_handler_relative(route)
  controller_file = route.fetch(:controller_file)
  unless File.basename(controller_file) == "endpoint_controller.rb"
    abort "Lambda/Graal endpoint must use a dedicated endpoint_controller.rb directory: #{controller_file}"
  end
  File.join(File.dirname(controller_file), "handler.rb")
end

def endpoint_handler_const(route)
  relative_dir = Pathname(File.dirname(route.fetch(:controller_file))).relative_path_from(Pathname("app/controllers"))
  modules = relative_dir.each_filename.map { |part| ruby_const(part) }
  abort "endpoint controller must live below app/controllers/<endpoint>/" if modules.empty?
  (modules + ["Handler"]).join("::")
end

def endpoint_action_portable!(route)
  source = File.read(File.join(ROOT, route.fetch(:controller_file)))
  action = Regexp.escape(route.fetch(:action))
  pattern = /def\s+#{action}\b[^\n]*\n\s*dispatch_ores_endpoint\s*\n\s*end\b/m
  return true if source.match?(pattern)

  abort "Rails endpoint #{route.fetch(:controller)}##{route.fetch(:action)} is not a portable dispatch_ores_endpoint action; refusing semantic drift"
end

def clean_generated_endpoint_handlers!
  Dir.glob(File.join(ROOT, "app/controllers/**/handler.rb")).each do |path|
    source = File.read(path)
    abort "refusing to overwrite non-generated handler sidecar: #{path}" unless source.include?(GENERATED_HANDLER_MARKER)
    FileUtils.rm_f(path)
  end
end

def prepare_endpoint_handlers!(routes)
  clean_generated_endpoint_handlers!

  routes.each do |route|
    endpoint_action_portable!(route)
    route[:handler_path] = endpoint_handler_relative(route)
    route[:handler_constant] = endpoint_handler_const(route)
  end

  collisions = routes.group_by { |route| route.fetch(:handler_path) }.select do |_path, rows|
    rows.map { |route| [route.fetch(:controller), route.fetch(:action)] }.uniq.length > 1
  end
  unless collisions.empty?
    detail = collisions.map { |path, rows| "#{path}: #{rows.map { |r| "#{r[:controller]}##{r[:action]}" }.uniq.join(", ")}" }.join("; ")
    abort "multiple Rails endpoints collide on one generated handler.rb: #{detail}"
  end

  routes.group_by { |route| route.fetch(:handler_path) }.each_value do |rows|
    route = rows.first
    path = File.join(ROOT, route.fetch(:handler_path))
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, <<~RUBY)
      # frozen_string_literal: true
      # #{GENERATED_HANDLER_MARKER}
      # Rails endpoint: #{route.fetch(:controller)}##{route.fetch(:action)}
      # Rails source: #{route.fetch(:controller_file)}
      # Rails view lookup: #{route.fetch(:view_logical_path)}

      module #{route.fetch(:handler_constant).split("::")[0...-1].join("::")}
        module Handler
          CONTROLLER_PATH = #{route.fetch(:controller).inspect}.freeze
          ACTION = #{route.fetch(:action).inspect}.freeze
          VIEW_LOGICAL_PATH = #{route.fetch(:view_logical_path).inspect}.freeze
          VIEW_FILES = #{route.fetch(:view_files).inspect}.freeze

          module_function

          def call(request)
            OresApp::Handlers.call(CONTROLLER_PATH, ACTION, request)
          end
        end
      end
    RUBY
  end
end

def handler_source(route)
  flatten_ruby_source(File.join(ROOT, route.fetch(:handler_path)))
end
def route_row(route)
  "OresApp::Routes::Route.new(" \
    "verb: #{route.fetch(:verb).inspect}, " \
    "path: #{route.fetch(:path).inspect}, " \
    "name: #{route.fetch(:name).inspect}, " \
    "controller: #{route.fetch(:controller).inspect}, " \
    "action: #{route.fetch(:action).inspect}, " \
    "middleware: #{route.fetch(:middleware).inspect}, " \
    "group: #{route.fetch(:group).inspect}, " \
    "pool: #{route.fetch(:pool).inspect}, " \
    "route_id: #{route_id(route).inspect})"
end

def route_manifest(route)
  route.merge(route_id: route_id(route)).reject { |key, _| key == :route_key }
end

def write_generated_routes(path, routes)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    require "ores_app/routes"

    module OresGenerated
      module Routes
        TABLE = [
          #{routes.map { |route| route_row(route) }.join(",\n          ")}
        ].freeze
      end
    end
  RUBY
end

def write_lambda_route_handler(path, route)
  FileUtils.mkdir_p(File.dirname(path))
  const = route_const(route)
  sidecar = route.fetch(:handler_path)
  sidecar_source = handler_source(route)
  File.write(path, <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    # Generated Rails endpoint sidecar: #{sidecar}
    require "ores_app/handlers"

    #{sidecar_source}

    module OresGenerated
      module RouteHandlers
        module #{const}
          module_function

          def call(request)
            ::#{route.fetch(:handler_constant)}.call(request)
          end
        end
      end
    end
  RUBY
end
def write_lambda_group_handler(path, group, routes)
  FileUtils.mkdir_p(File.dirname(path))
  sidecars = routes.uniq { |route| route.fetch(:handler_path) }.map { |route| handler_source(route) }.join("\n")
  cases = routes.map do |route|
    "when #{route_id(route).inspect} then ::#{route.fetch(:handler_constant)}.call(request)"
  end.join("\n            ")
  File.write(path, <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    require "ores_app/handlers"

    #{sidecars}

    module OresGenerated
      module GroupHandlers
        module #{ruby_const(group)}
          module_function

          def call(route, request)
            case route.route_id
            #{cases}
            else
              raise ArgumentError, "route " + route.route_id.inspect + " does not belong to group #{group}"
            end
          end
        end
      end
    end
  RUBY
end
def write_lambda_entrypoint(routes, granularity)
  route_requires = routes.map do |route|
    relative = route_unit_relative(route)
    %(require_relative #{relative.delete_suffix(".rb").inspect})
  end
  grouped = routes.group_by { |route| route.fetch(:group) }
  group_requires = grouped.keys.sort.map do |group|
    relative = group_unit_relative(group)
    %(require_relative #{relative.delete_suffix(".rb").inspect})
  end

  resolver = if granularity == "route"
               cases = routes.map do |route|
                 "when #{route_id(route).inspect} then OresGenerated::RouteHandlers::#{route_const(route)}.call(request)"
               end.join("\n            ")
               <<~RUBY
                 def invoke(route, request)
                   case route.route_id
                   #{cases}
                   else
                     raise ArgumentError, "no generated route handler for " + route.route_id.inspect
                   end
                 end
               RUBY
             else
               cases = grouped.keys.sort.map do |group|
                 "when #{group.inspect} then OresGenerated::GroupHandlers::#{ruby_const(group)}.call(route, request)"
               end.join("\n            ")
               <<~RUBY
                 def invoke(route, request)
                   case route.group
                   #{cases}
                   else
                     raise ArgumentError, "no generated group handler for " + route.group.inspect
                   end
                 end
               RUBY
             end

  requires = granularity == "route" ? route_requires : group_requires
  File.write(File.join(LAMBDA_DIR, "entrypoint.rb"), <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    app_root = File.expand_path("../..", __dir__)
    $LOAD_PATH.unshift(File.join(app_root, "lib")) unless $LOAD_PATH.include?(File.join(app_root, "lib"))
    require "ores_app/dispatcher"
    require_relative "routes"
    #{requires.join("\n    ")}

    module OresGenerated
      module LambdaEntrypoint
        module_function

        #{resolver.lines.map { |line| "        #{line}" }.join}

        def call(request)
          OresApp::Dispatcher.call(request, routes: OresGenerated::Routes::TABLE, invoker: method(:invoke))
        end
      end
    end
  RUBY
end

def flatten_ruby_source(path)
  File.readlines(path).reject { |line| line.match?(/^\s*require_relative\b/) }.join
end

def write_graal_common
  FileUtils.mkdir_p(GRAAL_DIR)
  source = String.new(<<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    # Shared immutable source evaluated once in every route/group Context.
    # The Java host should cache one Source object for this file per shared Engine.

    ORES_GRAAL_RUNTIME = true unless defined?(ORES_GRAAL_RUNTIME)
    ORES_EXECUTION_MODE = "graal" unless defined?(ORES_EXECUTION_MODE)
  RUBY

  %w[
    lib/ores_app/routes.rb
    lib/ores_app/middleware.rb
    lib/ores_app/http_database.rb
    lib/ores_app/handlers.rb
    lib/ores_app/thread_state_boundary.rb
    lib/ores_app/dispatcher.rb
  ].each do |relative|
    source << "\n# --- #{relative} ---\n"
    source << flatten_ruby_source(File.join(ROOT, relative))
    source << "\n"
  end
  path = File.join(GRAAL_DIR, "common.rb")
  File.write(path, source)
  path
end

def graal_unit_source(routes)
  cases = routes.map do |route|
    "when #{route_id(route).inspect} then ::#{route.fetch(:handler_constant)}.call(request)"
  end.join("\n          ")

  String.new(<<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    # Unit-specific source evaluated once after generated/graal/common.rb.

    module OresGenerated
      module Routes
        TABLE = [
          #{routes.map { |route| route_row(route) }.join(",\n          ")}
        ].freeze
      end

      module GraalEntrypoint
        module_function

        def invoke(route, request)
          case route.route_id
          #{cases}
          else
            raise ArgumentError, "route is not part of this isolate: " + route.route_id.inspect
          end
        end
      end
    end
  RUBY
end

def write_graal_unit(relative, routes)
  path = File.join(GRAAL_DIR, relative)
  FileUtils.mkdir_p(File.dirname(path))
  source = String.new("# frozen_string_literal: true\n# GENERATED FILE. DO NOT EDIT OR COMMIT.\n")
  routes.uniq { |route| route.fetch(:handler_path) }.each do |route|
    sidecar = route.fetch(:handler_path)
    source << "\n# --- GENERATED SIDECAR #{sidecar} ---\n"
    source << handler_source(route)
    source << "\n"
  end
  source << graal_unit_source(routes)
  source << "\n# --- graal/bootstrap.rb ---\n"
  source << flatten_ruby_source(File.join(ROOT, "graal/bootstrap.rb"))
  source << "\n"
  File.write(path, source)
  path
end
def compile_routes
  OresBuild::StaticRoutes.new(ROOT).compile.each do |route|
    route[:route_id] = route_id(route)
  end
end

def clean_output
  FileUtils.rm_rf(LAMBDA_DIR)
  FileUtils.rm_rf(GRAAL_DIR)
end

target = ENV.fetch("ORES_BUILD_TARGET", "rails").downcase

case target
when "rails"
  clean_output
  warn "build target=rails: no FaaS artifacts generated; boot the normal Rails application"
when "lambda"
  abort "Rails must not be loaded during Lambda generation" if defined?(Rails)
  granularity = ENV.fetch("ORES_LAMBDA_HANDLER_GRANULARITY", "route").downcase
  abort "ORES_LAMBDA_HANDLER_GRANULARITY must be route or group" unless %w[route group].include?(granularity)

  routes = compile_routes
  abort "no statically resolvable application routes found" if routes.empty?
  prepare_endpoint_handlers!(routes)
  FileUtils.rm_rf(LAMBDA_DIR)
  FileUtils.mkdir_p(LAMBDA_DIR)
  write_generated_routes(File.join(LAMBDA_DIR, "routes.rb"), routes)
  routes.each do |route|
    write_lambda_route_handler(File.join(LAMBDA_DIR, route_unit_relative(route)), route)
  end
  routes.group_by { |route| route.fetch(:group) }.each do |group, grouped|
    write_lambda_group_handler(File.join(LAMBDA_DIR, group_unit_relative(group)), group, grouped)
  end
  write_lambda_entrypoint(routes, granularity)

  manifest = {
    "schema" => "ores-lambda-manifest/v6",
    "application" => "ores-ror.rb",
    "entrypoint" => "generated/lambda/entrypoint.rb",
    "runtime" => "ruby",
    "rails_boot" => false,
    "rails_application_initialized" => false,
    "route_source" => "config/routes.rb:ripper-static",
    "rails_route_authority" => "config/routes.rb",
    "route_handler_authority" => "generated app/controllers/**/handler.rb sidecars",
    "router_runtime" => "generated-rails-route-contract",
    "middleware_runtime" => "shared-ruby-no-rails-app",
    "handler_granularity" => granularity,
    "routes" => routes.map do |route|
      route_manifest(route).merge(
        source_handler: route.fetch(:handler_path),
        route_handler: "generated/lambda/#{route_unit_relative(route)}",
        group_handler: "generated/lambda/#{group_unit_relative(route.fetch(:group))}"
      )
    end
  }
  File.write(File.join(LAMBDA_DIR, "manifest.json"), JSON.pretty_generate(manifest) + "\n")
  warn "build target=lambda: compiled #{routes.length} Rails-authored routes without loading Rails; granularity=#{granularity}"
when "graal"
  abort "Rails must not be loaded during Graal generation" if defined?(Rails)
  routes = compile_routes
  abort "no statically resolvable application routes found" if routes.empty?
  prepare_endpoint_handlers!(routes)
  FileUtils.rm_rf(GRAAL_DIR)
  write_graal_common

  units = []
  routes.each do |route|
    relative = route_unit_relative(route)
    write_graal_unit(relative, [route])
    units << {
      "kind" => "route",
      "key" => "route:#{route_id(route)}",
      "route_ids" => [route_id(route)],
      "group" => route.fetch(:group),
      "source_handler" => route.fetch(:handler_path),
      "sources" => ["generated/graal/common.rb", "generated/graal/#{relative}"],
      "language_context" => "ruby",
      "context_count" => 1,
      "host_thread_pool_size" => MAX_GRAAL_THREADS,
      "request_multiplexing" => true,
      "max_concurrency" => MAX_GRAAL_THREADS
    }
  end
  routes.group_by { |route| route.fetch(:group) }.each do |group, grouped|
    relative = group_unit_relative(group)
    write_graal_unit(relative, grouped)
    units << {
      "kind" => "group",
      "key" => "group:#{group}",
      "route_ids" => grouped.map { |route| route_id(route) },
      "group" => group,
      "source_handlers" => grouped.map { |route| route.fetch(:handler_path) },
      "sources" => ["generated/graal/common.rb", "generated/graal/#{relative}"],
      "language_context" => "ruby",
      "context_count" => 1,
      "host_thread_pool_size" => MAX_GRAAL_THREADS,
      "request_multiplexing" => true,
      "max_concurrency" => MAX_GRAAL_THREADS
    }
  end

  manifest = {
    "schema" => "ores-graal-ruby-manifest/v3",
    "application" => "ores-ror.rb",
    "runtime" => "truffleruby",
    "rails_boot" => false,
    "rails_application_initialized" => false,
    "route_source" => "config/routes.rb:ripper-static",
    "rails_route_authority" => "config/routes.rb",
    "route_handler_authority" => "generated app/controllers/**/handler.rb sidecars",
    "router_runtime" => "generated-rails-route-contract",
    "middleware_runtime" => "shared-ruby-no-rails-app",
    "engine_scope" => "process-shared",
    "language_context" => "ruby",
    "contexts_per_isolate" => 1,
    "host_thread_pool_size_per_context" => MAX_GRAAL_THREADS,
    "request_multiplexing" => true,
    "shared_source" => "generated/graal/common.rb",
    "source_memory" => "host-read-only-shareable",
    "context_lifetime" => "isolate",
    "context_model" => "one-long-lived-context-per-route-or-group-isolate",
    "supported_isolation_granularities" => %w[route group],
    "request_state" => "explicit-per-invocation",
    "thread_identity_is_request_identity" => false,
    "max_concurrency_per_isolate" => MAX_GRAAL_THREADS,
    "max_isolate_age_seconds" => 1800,
    "idle_retire_seconds" => 300,
    "hard_cancel_scope" => "isolate",
    "replacement_before_drain" => true,
    "host_http_binding" => "ores_gs_http",
    "guest_filesystem" => false,
    "guest_created_threads" => false,
    "child_processes" => false,
    "native_ffi" => false,
    "raw_sockets" => false,
    "database_transport" => "host-http",
    "routes" => routes.map { |route| route_manifest(route) },
    "isolate_units" => units
  }
  File.write(File.join(GRAAL_DIR, "manifest.json"), JSON.pretty_generate(manifest) + "\n")
  warn "build target=graal: generated #{routes.length} route isolates + #{routes.map { |route| route[:group] }.uniq.length} group isolates; Rails not loaded"
else
  abort "unsupported ORES_BUILD_TARGET=#{target.inspect}; expected rails, lambda, or graal"
end
