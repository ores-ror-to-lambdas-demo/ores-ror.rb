#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require_relative "../lib/ores_app/routes"

def ruby_const(value)
  value.to_s.split(/[^A-Za-z0-9]+/).reject(&:empty?).map { |part| part[0].upcase + part[1..].to_s }.join
end

def generated_route_relative_path(route)
  OresApp::Routes.handler_relative_path(route).delete_prefix("routes/")
end

def generated_route_require_path(route)
  generated_route_relative_path(route).delete_suffix(".rb")
end

def route_manifest(routes)
  routes.map do |route|
    {
      method: route.verb,
      path: route.path,
      handler: route.handler,
      name: route.name,
      middleware: route.middleware,
      group: route.group,
      pool: route.pool,
      source_handler: OresApp::Routes.handler_relative_path(route)
    }
  end
end

def validate_source_handlers!(routes)
  missing = routes.reject { |route| File.file?(OresApp::Routes.handler_path(route)) }
  return if missing.empty?

  abort "missing committed route handlers: #{missing.map { |route| OresApp::Routes.handler_relative_path(route) }.join(", ")}"
end

def write_route_handler(lambda_dir, route)
  handler_path = File.join(lambda_dir, "routes", generated_route_relative_path(route))
  FileUtils.mkdir_p(File.dirname(handler_path))
  const_name = ruby_const(route.name)
  File.write(handler_path, <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    require "ores_app/route_handlers"

    module OresGenerated
      module Routes
        module #{const_name}
          module_function

          def call(request)
            OresApp::RouteHandlers.call(#{route.name.inspect}, request)
          end
        end
      end
    end
  RUBY
end

def write_group_handler(lambda_dir, group, routes)
  group_dir = File.join(lambda_dir, "groups", group)
  FileUtils.mkdir_p(group_dir)
  requires = routes.map { |route| %(require_relative "../../routes/#{generated_route_require_path(route)}") }.join("\n")
  cases = routes.map do |route|
    %(when #{route.name.inspect} then OresGenerated::Routes::#{ruby_const(route.name)}.call(request))
  end.join("\n          ")

  File.write(File.join(group_dir, "handler.rb"), <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    #{requires}

    module OresGenerated
      module Groups
        module #{ruby_const(group)}
          module_function

          def call(route, request)
            case route.name
            #{cases}
            else
              raise ArgumentError, "route \#{route.name.inspect} does not belong to group #{group}"
            end
          end
        end
      end
    end
  RUBY
end

def write_lambda_entrypoint(lambda_dir, granularity, routes)
  if granularity == "route"
    requires = routes.map { |route| %(require_relative "routes/#{generated_route_require_path(route)}") }.join("\n")
    cases = routes.map do |route|
      %(when #{route.name.inspect} then OresGenerated::Routes::#{ruby_const(route.name)}.call(request))
    end.join("\n            ")
    resolver = <<~RUBY
      def invoke(route, request)
        case route.name
        #{cases}
        else
          raise ArgumentError, "no generated route handler for \#{route.name.inspect}"
        end
      end
    RUBY
  else
    groups = routes.group_by(&:group)
    requires = groups.keys.sort.map { |group| %(require_relative "groups/#{group}/handler") }.join("\n")
    cases = groups.keys.sort.map do |group|
      %(when #{group.inspect} then OresGenerated::Groups::#{ruby_const(group)}.call(route, request))
    end.join("\n            ")
    resolver = <<~RUBY
      def invoke(route, request)
        case route.group
        #{cases}
        else
          raise ArgumentError, "no generated group handler for \#{route.group.inspect}"
        end
      end
    RUBY
  end

  File.write(File.join(lambda_dir, "entrypoint.rb"), <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    app_root = File.expand_path("../..", __dir__)
    $LOAD_PATH.unshift(File.join(app_root, "lib")) unless $LOAD_PATH.include?(File.join(app_root, "lib"))

    require "ores_app/dispatcher"
    #{requires}

    module OresGenerated
      module LambdaEntrypoint
        module_function

        #{resolver.lines.map { |line| "        #{line}" }.join}

        def call(request)
          OresApp::Dispatcher.call(request, invoker: method(:invoke))
        end
      end
    end
  RUBY
end

def flatten_ruby_source(path)
  File.readlines(path).reject do |line|
    line.match?(/^\s*require_relative\b/)
  end.join
end

def write_graal_bundle(root, graal_dir, routes)
  FileUtils.rm_rf(graal_dir)
  FileUtils.mkdir_p(graal_dir)

  source = String.new(<<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    # Rails-free single-source TruffleRuby worker bundle.
    #
    # The host inserts `gs_http` into the Ruby top-level binding before evaluating
    # this source. One Graal Context evaluates this file exactly once and is then
    # entered concurrently by the isolate's bounded host executor.

    ORES_GRAAL_RUNTIME = true unless defined?(ORES_GRAAL_RUNTIME)
    ORES_EXECUTION_MODE = "graal" unless defined?(ORES_EXECUTION_MODE)
    ORES_GS_HTTP = gs_http unless defined?(ORES_GS_HTTP)

    module Ores
      module Context
        KEY = :__ores_invocation_context

        module_function

        def current
          Thread.current[KEY]
        end

        def with(value)
          previous = Thread.current[KEY]
          Thread.current[KEY] = value
          yield
        ensure
          Thread.current[KEY] = previous
        end
      end

      module ThreadStateBoundary
        module_function

        def call
          thread = Thread.current
          fiber_keys = thread.keys
          fiber_state = fiber_keys.to_h { |key| [key, thread[key]] }
          thread_keys = thread.thread_variables
          thread_state = thread_keys.to_h { |key| [key, thread.thread_variable_get(key)] }

          yield
        ensure
          if thread
            (thread.keys - fiber_keys).each { |key| thread[key] = nil }
            fiber_state.each { |key, value| thread[key] = value }

            (thread.thread_variables - thread_keys).each { |key| thread.thread_variable_set(key, nil) }
            thread_state.each { |key, value| thread.thread_variable_set(key, value) }
          end
        end
      end
    end

    module OresApp
      module RouteHandlers
      end
    end
  RUBY

  core_sources = %w[
    lib/ores_app/routes.rb
    lib/ores_app/middleware.rb
    lib/ores_app/http_database.rb
    lib/ores_app/handlers.rb
  ]

  core_sources.each do |relative|
    source << "\n# --- #{relative} ---\n"
    source << flatten_ruby_source(File.join(root, relative))
    source << "\n"
  end

  routes.each do |route|
    relative = OresApp::Routes.handler_relative_path(route)
    source << "\n# --- #{relative} ---\n"
    source << flatten_ruby_source(File.join(root, relative))
    source << "\n"
  end

  source << "\n# --- lib/ores_app/dispatcher.rb ---\n"
  source << flatten_ruby_source(File.join(root, "lib/ores_app/dispatcher.rb"))
  source << "\n"

  cases = routes.map do |route|
    %(when #{route.name.inspect} then OresApp::RouteHandlers::#{ruby_const(route.name)}.call(request))
  end.join("\n        ")

  source << <<~RUBY

    module OresGenerated
      module GraalEntrypoint
        module_function

        def invoke(route, request)
          case route.name
          #{cases}
          else
            raise ArgumentError, "no generated Graal route handler for \#{route.name.inspect}"
          end
        end

        def call(raw_request)
          Ores::ThreadStateBoundary.call do
            Ores::Context.with(raw_request.freeze) do
              OresApp::Dispatcher.call(raw_request, invoker: method(:invoke))
            end
          end
        end
      end
    end

    def ores_graal_invoke(request_json)
      request = JSON.parse(request_json.to_s)
      JSON.generate(OresGenerated::GraalEntrypoint.call(request))
    end

    method(:ores_graal_invoke)
  RUBY

  handler = File.join(graal_dir, "handler.rb")
  File.write(handler, source)

  manifest = {
    "schema" => "ores-graal-ruby-manifest/v2",
    "application" => "ores-ror.rb",
    "entrypoint" => "generated/graal/handler.rb",
    "runtime" => "truffleruby",
    "rails_boot" => false,
    "single_source" => true,
    "context_lifetime" => "isolate",
    "request_state" => "explicit-per-invocation",
    "thread_identity_is_request_identity" => false,
    "thread_state_boundary" => "snapshot-and-restore",
    "max_concurrency_per_isolate" => 5,
    "max_isolate_age_seconds" => 1800,
    "idle_retire_seconds" => 300,
    "guest_created_threads" => false,
    "guest_filesystem" => false,
    "child_processes" => false,
    "native_ffi" => false,
    "raw_sockets" => false,
    "database_transport" => "host-http",
    "hard_cancellation" => "drain-replace-context",
    "routes" => route_manifest(routes)
  }

  File.write(File.join(graal_dir, "manifest.json"), JSON.pretty_generate(manifest) + "\n")
end

target = ENV.fetch("ORES_BUILD_TARGET", "rails").downcase
root = File.expand_path("..", __dir__)
output_root = File.expand_path(ENV.fetch("ORES_BUILD_OUTPUT", "../generated"), __dir__)
lambda_dir = File.join(output_root, "lambda")
graal_dir = File.join(output_root, "graal")
routes = OresApp::Routes::TABLE

case target
when "rails"
  FileUtils.rm_rf(lambda_dir)
  FileUtils.rm_rf(graal_dir)
  warn "build target=rails: no FaaS runtime generated; boot Rails normally"
when "lambda"
  granularity = ENV.fetch("ORES_LAMBDA_HANDLER_GRANULARITY", "route").downcase
  abort "ORES_LAMBDA_HANDLER_GRANULARITY must be route or group" unless %w[route group].include?(granularity)

  validate_source_handlers!(routes)
  FileUtils.rm_rf(lambda_dir)
  FileUtils.mkdir_p(lambda_dir)

  routes.each { |route| write_route_handler(lambda_dir, route) }
  routes.group_by(&:group).each { |group, grouped_routes| write_group_handler(lambda_dir, group, grouped_routes) }
  write_lambda_entrypoint(lambda_dir, granularity, routes)

  manifest = {
    "schema" => "ores-lambda-manifest/v2",
    "application" => "ores-ror.rb",
    "entrypoint" => "generated/lambda/entrypoint.rb",
    "runtime" => "ruby",
    "rails_boot" => false,
    "handler_granularity" => granularity,
    "routes" => route_manifest(routes).map do |entry|
      route = routes.find { |candidate| candidate.name == entry.fetch(:name) }
      entry.merge(
        route_handler: "generated/lambda/routes/#{generated_route_relative_path(route)}",
        group_handler: "generated/lambda/groups/#{entry.fetch(:group)}/handler.rb"
      )
    end
  }

  File.write(File.join(lambda_dir, "manifest.json"), JSON.pretty_generate(manifest) + "\n")
  warn "build target=lambda: generated URL-shaped route handlers in #{lambda_dir}; active granularity=#{granularity}; Rails not booted"
when "graal"
  validate_source_handlers!(routes)
  write_graal_bundle(root, graal_dir, routes)
  warn "build target=graal: generated one long-lived-context TruffleRuby bundle in #{graal_dir}; Rails not booted"
else
  abort "unsupported ORES_BUILD_TARGET=#{target.inspect}; expected rails, lambda, or graal"
end
