#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "pathname"
require "ripper"

ROOT = File.expand_path("..", __dir__)
OUTPUT_ROOT = File.expand_path(ENV.fetch("ORES_BUILD_OUTPUT", "../generated"), __dir__)
LAMBDA_DIR = File.join(OUTPUT_ROOT, "lambda")
ROUTES_FILE = File.join(ROOT, "config", "routes.rb")
HTTP_VERBS = %w[get post put patch delete options head].freeze
UNSUPPORTED_ROUTE_DSL = %w[
  resources resource namespace scope match root mount concern concerns direct resolve
].freeze

def ruby_const(value)
  value.to_s.split(/[^A-Za-z0-9]+/).reject(&:empty?).map { |part| part[0].upcase + part[1..].to_s }.join
end

def controller_class_name(controller_path)
  controller_path.split("/").map { |part| ruby_const(part) }.join("::") + "Controller"
end

def handler_constant_name(endpoint_dir)
  controllers_root = Pathname.new(File.join(ROOT, "app", "controllers"))
  relative = Pathname.new(endpoint_dir).relative_path_from(controllers_root)
  (relative.each_filename.map { |part| ruby_const(part) } + ["Handler"]).join("::")
end

def nested_module_source(constant_name, body)
  parts = constant_name.split("::")
  indent = +""
  source = +""

  parts.each do |part|
    source << "#{indent}module #{part}\n"
    indent << "  "
  end

  body.each_line { |line| source << "#{indent}#{line}" }

  parts.reverse_each do
    indent = indent.delete_suffix("  ")
    source << "#{indent}end\n"
  end

  source
end

def walk_sexp(node, &block)
  return unless node.is_a?(Array)

  yield node
  node.each { |child| walk_sexp(child, &block) if child.is_a?(Array) }
end

def call_name_and_args(node)
  case node[0]
  when :command
    ident = node[1]
    return unless ident&.[](0) == :@ident

    [ident[1], node[2], ident[2]&.first]
  when :method_add_arg
    callee = node[1]
    return unless callee&.[](0) == :fcall
    ident = callee[1]
    return unless ident&.[](0) == :@ident

    args = node[2]
    args = args[1] if args&.[](0) == :arg_paren
    [ident[1], args, ident[2]&.first]
  end
end

def argument_nodes(args_node)
  return [] unless args_node.is_a?(Array)
  return args_node[1] || [] if args_node[0] == :args_add_block

  []
end

def static_string(node)
  return unless node.is_a?(Array) && node[0] == :string_literal

  content = node[1]
  return "" if content == [:string_content]
  return unless content.is_a?(Array) && content[0] == :string_content

  pieces = content.drop(1)
  return unless pieces.all? { |piece| piece.is_a?(Array) && piece[0] == :@tstring_content }

  pieces.map { |piece| piece[1] }.join
end

def static_symbol(node)
  return unless node.is_a?(Array) && node[0] == :symbol_literal

  symbol = node.dig(1, 1)
  return unless symbol.is_a?(Array) && %i[@ident @op @const].include?(symbol[0])

  symbol[1]
end

def static_literal(node)
  static_string(node) || static_symbol(node)
end

def keyword_pairs(node)
  return {} unless node.is_a?(Array)

  pairs =
    case node[0]
    when :bare_assoc_hash
      node[1] || []
    when :hash
      assoc = node[1]
      assoc&.[](0) == :assoclist_from_args ? (assoc[1] || []) : []
    else
      []
    end

  pairs.each_with_object({}) do |pair, out|
    next unless pair.is_a?(Array) && pair[0] == :assoc_new

    key_node, value_node = pair[1], pair[2]
    next unless key_node.is_a?(Array) && key_node[0] == :@label

    out[key_node[1].delete_suffix(":")] = static_literal(value_node)
  end
end

def source_defines_action?(source_file, action)
  sexp = Ripper.sexp(File.read(source_file))
  return false unless sexp

  found = false
  walk_sexp(sexp) do |node|
    next unless node[0] == :def

    ident = node[1]
    if ident.is_a?(Array) && ident[0] == :@ident && ident[1] == action
      found = true
      break
    end
  end
  found
end

def route_identifier(explicit_name, verb:, path:, controller:, action:)
  return explicit_name unless explicit_name.nil? || explicit_name.empty?

  digest = Digest::SHA256.hexdigest("#{verb} #{path} #{controller}##{action}")[0, 12]
  "rails_#{digest}"
end

def parse_static_routes
  source = File.read(ROUTES_FILE)
  sexp = Ripper.sexp(source)
  abort "cannot parse #{ROUTES_FILE}" unless sexp

  routes = []
  unsupported = []

  walk_sexp(sexp) do |node|
    call = call_name_and_args(node)
    next unless call

    method_name, args_node, line = call
    if UNSUPPORTED_ROUTE_DSL.include?(method_name)
      unsupported << "#{method_name} at line #{line || "?"}"
      next
    end
    next unless HTTP_VERBS.include?(method_name)

    args = argument_nodes(args_node)
    path = static_string(args[0])
    options = args.filter_map { |arg| keyword_pairs(arg) }.reduce({}, :merge)

    target = options["to"]
    controller = options["controller"]
    action = options["action"]

    if target
      unless target.include?("#")
        abort "static route parser requires controller#action in to: for #{method_name.upcase} at line #{line || "?"}"
      end
      controller, action = target.split("#", 2)
    end

    unless path && controller && action
      abort "static route parser could not resolve #{method_name.upcase} route at line #{line || "?"}; use literal path and to: \"controller#action\""
    end

    controller_file = File.join(ROOT, "app", "controllers", "#{controller}_controller.rb")
    unless File.file?(controller_file)
      abort "Rails convention expected controller file #{Pathname.new(controller_file).relative_path_from(Pathname.new(ROOT))}"
    end
    unless source_defines_action?(controller_file, action)
      abort "Rails convention expected #{controller_class_name(controller)}##{action} in #{Pathname.new(controller_file).relative_path_from(Pathname.new(ROOT))}"
    end

    endpoint_dir = File.dirname(controller_file)
    handler_file = File.join(endpoint_dir, "handler.rb")
    handler_rel = Pathname.new(handler_file).relative_path_from(Pathname.new(ROOT)).to_s
    controller_rel = Pathname.new(controller_file).relative_path_from(Pathname.new(ROOT)).to_s
    view_logical_path = "#{controller}/#{action}"
    view_glob = File.join(ROOT, "app", "views", controller, "#{action}.*")
    view_files = Dir.glob(view_glob).sort.map do |file|
      Pathname.new(file).relative_path_from(Pathname.new(ROOT)).to_s
    end
    group = controller.split("/").first
    name = route_identifier(options["as"], verb: method_name.upcase, path: path, controller: controller, action: action)

    routes << {
      verb: method_name.upcase,
      path: path,
      name: name,
      controller: controller,
      controller_class: controller_class_name(controller),
      action: action,
      controller_file: controller_rel,
      endpoint_dir: Pathname.new(endpoint_dir).relative_path_from(Pathname.new(ROOT)).to_s,
      handler_file: handler_file,
      handler_path: handler_rel,
      handler_constant: handler_constant_name(endpoint_dir),
      view_logical_path: view_logical_path,
      view_files: view_files,
      middleware: %w[request_id],
      group: group,
      pool: group
    }
  end

  unless unsupported.empty?
    abort "Lambda/Graal static codegen does not execute Rails routing DSL. Unsupported routing constructs: #{unsupported.uniq.join(", ")}"
  end

  routes
end

def clean_generated_handlers!
  pattern = File.join(ROOT, "app", "controllers", "**", "handler.rb")
  Dir.glob(pattern).each do |path|
    contents = File.read(path)
    unless contents.include?("GENERATED FILE. DO NOT EDIT OR COMMIT.")
      abort "refusing to overwrite non-generated endpoint handler: #{path}"
    end
    FileUtils.rm_f(path)
  end
end

def validate_handler_collisions!(routes)
  collisions = routes.group_by { |route| route.fetch(:handler_path) }.select do |_path, members|
    members.map { |route| [route.fetch(:controller), route.fetch(:action)] }.uniq.length > 1
  end
  return if collisions.empty?

  detail = collisions.map do |path, members|
    endpoints = members.map { |route| "#{route.fetch(:controller)}##{route.fetch(:action)}" }.uniq.join(", ")
    "#{path}: #{endpoints}"
  end.join("; ")
  abort "endpoint-per-folder convention violated; multiple Rails endpoints map to one generated handler.rb: #{detail}"
end

def write_colocated_handler(route)
  FileUtils.mkdir_p(File.dirname(route.fetch(:handler_file)))

  body = <<~RUBY
    CONTROLLER_PATH = #{route.fetch(:controller).inspect}.freeze
    CONTROLLER_CLASS = #{route.fetch(:controller_class).inspect}.freeze
    CONTROLLER_FILE = #{route.fetch(:controller_file).inspect}.freeze
    ACTION = #{route.fetch(:action).inspect}.freeze
    VIEW_LOGICAL_PATH = #{route.fetch(:view_logical_path).inspect}.freeze
    VIEW_FILES = #{route.fetch(:view_files).inspect}.freeze

    module_function

    def call(request)
      OresApp::Handlers.call(CONTROLLER_PATH, ACTION, request)
    end

    def view_logical_path
      VIEW_LOGICAL_PATH
    end

    def view_files
      VIEW_FILES
    end
  RUBY

  File.write(route.fetch(:handler_file), <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    #
    # Derived statically from Rails conventions; Rails is never loaded here.
    # Rails source: #{route.fetch(:controller_file)}
    # Rails endpoint: #{route.fetch(:controller)}##{route.fetch(:action)}
    # Rails view lookup: #{route.fetch(:view_logical_path)}

    require "ores_app/handlers"

    #{nested_module_source(route.fetch(:handler_constant), body)}
  RUBY
end

def write_generated_routes(routes)
  rows = routes.map do |route|
    "      OresApp::Routes::Route.new(verb: #{route.fetch(:verb).inspect}, path: #{route.fetch(:path).inspect}, name: #{route.fetch(:name).inspect}, controller: #{route.fetch(:controller).inspect}, action: #{route.fetch(:action).inspect}, middleware: #{route.fetch(:middleware).inspect}, group: #{route.fetch(:group).inspect}, pool: #{route.fetch(:pool).inspect}, handler_path: #{route.fetch(:handler_path).inspect}, handler_constant: #{route.fetch(:handler_constant).inspect}, view_logical_path: #{route.fetch(:view_logical_path).inspect}, view_files: #{route.fetch(:view_files).inspect})"
  end

  File.write(File.join(LAMBDA_DIR, "routes.rb"), <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    require "ores_app/routes"

    module OresGenerated
      module Routes
        TABLE = [
    #{rows.join(",\n")}
        ].freeze
      end
    end
  RUBY
end

def write_group_handler(group, routes)
  group_dir = File.join(LAMBDA_DIR, "groups", group)
  FileUtils.mkdir_p(group_dir)
  cases = routes.map do |route|
    %(when #{route.fetch(:name).inspect} then ::#{route.fetch(:handler_constant)}.call(request))
  end.join("\n          ")

  File.write(File.join(group_dir, "handler.rb"), <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    module OresGenerated
      module Groups
        module #{ruby_const(group)}
          module_function

          def call(route, request)
            case route.name
            #{cases}
            else
              raise ArgumentError, "route " + route.name.inspect + " does not belong to group #{group}"
            end
          end
        end
      end
    end
  RUBY
end

def write_entrypoint(routes, granularity)
  handler_requires = routes.map do |route|
    %(require File.join(app_root, #{route.fetch(:handler_path).inspect}))
  end.join("\n")

  if granularity == "route"
    cases = routes.map do |route|
      %(when #{route.fetch(:name).inspect} then ::#{route.fetch(:handler_constant)}.call(request))
    end.join("\n            ")
    resolver = <<~RUBY
      def invoke(route, request)
        case route.name
        #{cases}
        else
          raise ArgumentError, "no generated endpoint handler for " + route.name.inspect
        end
      end
    RUBY
    group_requires = ""
  else
    groups = routes.group_by { |route| route.fetch(:group) }
    group_requires = groups.keys.sort.map { |group| %(require_relative "groups/#{group}/handler") }.join("\n")
    cases = groups.keys.sort.map do |group|
      %(when #{group.inspect} then OresGenerated::Groups::#{ruby_const(group)}.call(route, request))
    end.join("\n            ")
    resolver = <<~RUBY
      def invoke(route, request)
        case route.group
        #{cases}
        else
          raise ArgumentError, "no generated group handler for " + route.group.inspect
        end
      end
    RUBY
  end

  File.write(File.join(LAMBDA_DIR, "entrypoint.rb"), <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    app_root = File.expand_path("../..", __dir__)
    $LOAD_PATH.unshift(File.join(app_root, "lib")) unless $LOAD_PATH.include?(File.join(app_root, "lib"))

    require "ores_app/dispatcher"
    require_relative "routes"
    #{handler_requires}
    #{group_requires}

    module OresGenerated
      module LambdaEntrypoint
        module_function

        #{resolver.lines.map { |line| "        #{line}" }.join}

        def call(request)
          OresApp::Dispatcher.call(request, routes: OresGenerated::Routes::TABLE, invoker: method(:invoke))
        end
      end
    end
  RUBY
end

target = ENV.fetch("ORES_BUILD_TARGET", "rails").downcase

case target
when "rails"
  FileUtils.rm_rf(LAMBDA_DIR)
  warn "build target=rails: no FaaS generation; Rails boots only through the normal Rails server/application path"
when "lambda"
  abort "Rails must not be loaded during Lambda/Graal generation" if defined?(Rails)

  granularity = ENV.fetch("ORES_LAMBDA_HANDLER_GRANULARITY", "route").downcase
  abort "ORES_LAMBDA_HANDLER_GRANULARITY must be route or group" unless %w[route group].include?(granularity)

  clean_generated_handlers!
  routes = parse_static_routes
  abort "no statically resolvable application routes found in config/routes.rb" if routes.empty?
  validate_handler_collisions!(routes)

  routes.each { |route| write_colocated_handler(route) }

  FileUtils.rm_rf(LAMBDA_DIR)
  FileUtils.mkdir_p(LAMBDA_DIR)
  write_generated_routes(routes)
  routes.group_by { |route| route.fetch(:group) }.each { |group, grouped| write_group_handler(group, grouped) }
  write_entrypoint(routes, granularity)

  manifest = {
    "schema" => "ores-lambda-manifest/v5",
    "application" => "ores-ror.rb",
    "entrypoint" => "generated/lambda/entrypoint.rb",
    "runtime" => "ruby",
    "rails_boot" => false,
    "route_source" => "config/routes.rb:static-ripper",
    "view_root" => "app/views",
    "handler_granularity" => granularity,
    "routes" => routes.map do |route|
      route.reject { |key, _| key == :handler_file }.merge(
        group_handler: "generated/lambda/groups/#{route.fetch(:group)}/handler.rb"
      )
    end
  }

  File.write(File.join(LAMBDA_DIR, "manifest.json"), JSON.pretty_generate(manifest) + "\n")
  warn "build target=lambda: statically derived #{routes.length} endpoints without Rails; generated co-located handlers; granularity=#{granularity}"
else
  abort "unsupported ORES_BUILD_TARGET=#{target.inspect}; expected rails or lambda"
end
