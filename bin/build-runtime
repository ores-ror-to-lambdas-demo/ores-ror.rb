#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "json"
require_relative "../lib/ores_app/routes"

def ruby_const(value)
  value.to_s.split(/[^A-Za-z0-9]+/).reject(&:empty?).map { |part| part[0].upcase + part[1..].to_s }.join
end

def validate_endpoint_controllers!(routes)
  missing = routes.reject { |route| File.file?(OresApp::Routes.controller_path(route)) }
  return if missing.empty?

  abort "missing endpoint controllers: #{missing.map { |route| OresApp::Routes.controller_relative_path(route) }.join(", ")}"
end

def write_colocated_handler(route)
  path = OresApp::Routes.handler_path(route)
  FileUtils.mkdir_p(File.dirname(path))
  const_name = ruby_const(route.name)

  File.write(path, <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.
    # Source controller: #{OresApp::Routes.controller_relative_path(route)}

    require "ores_app/handlers"

    module OresGenerated
      module EndpointHandlers
        module #{const_name}
          module_function

          def call(request)
            OresApp::Handlers.call(#{route.handler.inspect}, request)
          end
        end
      end
    end
  RUBY
end

def write_group_handler(lambda_dir, group, routes)
  group_dir = File.join(lambda_dir, "groups", group)
  FileUtils.mkdir_p(group_dir)
  cases = routes.map do |route|
    %(when #{route.name.inspect} then OresGenerated::EndpointHandlers::#{ruby_const(route.name)}.call(request))
  end.join("\n          ")

  File.write(File.join(group_dir, "handler.rb"), <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    module OresGenerated
      module Groups
        module #{ruby_const(group)}
          module_function

          def call(route, request)
            case route.name
            #{cases}
            else
              raise ArgumentError, "route \#{route.name.inspect} does not belong to group #{group}"
            end
          end
        end
      end
    end
  RUBY
end

def write_entrypoint(root, lambda_dir, granularity, routes)
  handler_requires = routes.map do |route|
    %(require File.join(app_root, #{OresApp::Routes.handler_relative_path(route).inspect}))
  end.join("\n")

  if granularity == "route"
    cases = routes.map do |route|
      %(when #{route.name.inspect} then OresGenerated::EndpointHandlers::#{ruby_const(route.name)}.call(request))
    end.join("\n            ")
    resolver = <<~RUBY
      def invoke(route, request)
        case route.name
        #{cases}
        else
          raise ArgumentError, "no generated endpoint handler for \#{route.name.inspect}"
        end
      end
    RUBY
    group_requires = ""
  else
    groups = routes.group_by(&:group)
    group_requires = groups.keys.sort.map { |group| %(require_relative "groups/#{group}/handler") }.join("\n")
    cases = groups.keys.sort.map do |group|
      %(when #{group.inspect} then OresGenerated::Groups::#{ruby_const(group)}.call(route, request))
    end.join("\n            ")
    resolver = <<~RUBY
      def invoke(route, request)
        case route.group
        #{cases}
        else
          raise ArgumentError, "no generated group handler for \#{route.group.inspect}"
        end
      end
    RUBY
  end

  File.write(File.join(lambda_dir, "entrypoint.rb"), <<~RUBY)
    # frozen_string_literal: true
    # GENERATED FILE. DO NOT EDIT OR COMMIT.

    app_root = File.expand_path("../..", __dir__)
    $LOAD_PATH.unshift(File.join(app_root, "lib")) unless $LOAD_PATH.include?(File.join(app_root, "lib"))

    require "ores_app/dispatcher"
    #{handler_requires}
    #{group_requires}

    module OresGenerated
      module LambdaEntrypoint
        module_function

        #{resolver.lines.map { |line| "        #{line}" }.join}

        def call(request)
          OresApp::Dispatcher.call(request, invoker: method(:invoke))
        end
      end
    end
  RUBY
end

target = ENV.fetch("ORES_BUILD_TARGET", "rails").downcase
output_root = File.expand_path(ENV.fetch("ORES_BUILD_OUTPUT", "../generated"), __dir__)
lambda_dir = File.join(output_root, "lambda")
routes = OresApp::Routes::TABLE

case target
when "rails"
  FileUtils.rm_rf(lambda_dir)
  warn "build target=rails: boot Rails normally; endpoint handler.rb files are generated only for FaaS builds"
when "lambda"
  granularity = ENV.fetch("ORES_LAMBDA_HANDLER_GRANULARITY", "route").downcase
  abort "ORES_LAMBDA_HANDLER_GRANULARITY must be route or group" unless %w[route group].include?(granularity)

  validate_endpoint_controllers!(routes)
  routes.each { |route| write_colocated_handler(route) }

  FileUtils.rm_rf(lambda_dir)
  FileUtils.mkdir_p(lambda_dir)
  routes.group_by(&:group).each { |group, grouped_routes| write_group_handler(lambda_dir, group, grouped_routes) }
  write_entrypoint(File.expand_path("..", __dir__), lambda_dir, granularity, routes)

  manifest = {
    "schema" => "ores-lambda-manifest/v3",
    "application" => "ores-ror.rb",
    "entrypoint" => "generated/lambda/entrypoint.rb",
    "runtime" => "ruby",
    "rails_boot" => false,
    "handler_granularity" => granularity,
    "routes" => OresApp::Routes.manifest.map do |entry|
      entry.merge(
        group_handler: "generated/lambda/groups/#{entry.fetch(:group)}/handler.rb"
      )
    end
  }

  File.write(File.join(lambda_dir, "manifest.json"), JSON.pretty_generate(manifest) + "\n")
  warn "build target=lambda: generated endpoint-local handler.rb files plus #{lambda_dir}; granularity=#{granularity}"
else
  abort "unsupported ORES_BUILD_TARGET=#{target.inspect}; expected rails or lambda"
end
